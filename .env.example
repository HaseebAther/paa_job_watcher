PAA_EMAIL=you@example.com
PAA_PASSWORD=your-password
# Optional but recommended: instant phone alerts. Create a bot with @BotFather,
# message it once, then get your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
POLL_SECONDS=60
# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=
